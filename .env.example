# ==============================================================================
# GoTangguh / GoResilio — Environment Configuration Template
# Copy this file to .env.local for local development or .env for production.
# NEVER commit your actual .env or .env.local file with real secrets to Git.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=https://gotangguh.id

# ==============================================================================
# Security & Session Authentication
# ==============================================================================
# Generate a cryptographically strong 64-character secret:
# openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Rate Limiter Window (Optional overrides)
# RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# Database Configuration (MySQL 8.0+)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gotangguh_user
DB_PASSWORD=your_secure_db_password
DB_NAME=gotangguh_db

# ==============================================================================
# Commercial & Customer Support
# ==============================================================================
# WhatsApp Admin contact number for customer orders & expert consultation
# Format: International country code without + or dashes (e.g. 6281199887766)
NEXT_PUBLIC_ADMIN_WHATSAPP=6281199887766
NEXT_PUBLIC_SUPPORT_EMAIL=admin.ops@gotangguh.id

# ==============================================================================
# Geospatial & Environmental Data Providers (Optional / Fallback Enabled)
# ==============================================================================
# Mapbox public token for satellite vector tiles (optional, OSM fallback default)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenWeatherMap API Key (optional, Open-Meteo default)
OPENWEATHER_API_KEY=

# NASA FIRMS MAP_KEY for real-time satellite fire hotspots (optional)
NASA_FIRMS_MAP_KEY=
